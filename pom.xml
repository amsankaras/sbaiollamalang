    </dependencies>

    <repositories>
        <repository>
            <id>langchain4j-repo</id>
            <url>https://example.com/langchain4j-repo</url>
        </repository>
        <repository>
            <id>langraph4j-repo</id>
            <url>https://example.com/langraph4j-repo</url>
        </repository>
        <repository>
            <id>ollama-repo</id>
            <url>https://example.com/ollama-repo</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.openrewrite.maven</groupId>
                <artifactId>rewrite-maven-plugin</artifactId>
                <version>5.47.3</version>
            </plugin>
        </plugins>
    </build>
</project>